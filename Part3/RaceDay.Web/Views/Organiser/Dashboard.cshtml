@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="rd-title mb-0">Dashboard</h1>
    <a class="btn btn-rd" asp-controller="OrganiserEvents" asp-action="Create">+ New event</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card rd-card p-3"><div class="rd-stat">@Model.TotalEvents</div><div class="rd-meta">Events</div></div></div>
    <div class="col-6 col-lg-3"><div class="card rd-card p-3"><div class="rd-stat">@Model.UpcomingCount</div><div class="rd-meta">Upcoming</div></div></div>
    <div class="col-6 col-lg-3"><div class="card rd-card p-3"><div class="rd-stat">@Model.TotalEnrolments</div><div class="rd-meta">Total enrolments</div></div></div>
    <div class="col-6 col-lg-3"><div class="card rd-card p-3"><div class="rd-stat rd-stat-sm">@(Model.NextEvent is null ? "—" : Fmt.ShortDate(Model.NextEvent.EventDate))</div><div class="rd-meta">Next event</div></div></div>
</div>

@if (!Model.Events.Any())
{
    <div class="rd-empty text-center">
        <p>You have not created any events yet.</p>
        <a class="btn btn-rd" asp-controller="OrganiserEvents" asp-action="Create">Create your first event</a>
    </div>
}
else
{
    <div class="card rd-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Event</th><th>Date</th><th>Categories</th><th>Enrolments</th><th></th></tr></thead>
                <tbody>
                @foreach (var e in Model.Events.OrderBy(e => e.EventDate))
                {
                    <tr>
                        <td>@Fmt.TypeIcon(e.EventType) @e.Name</td>
                        <td>@Fmt.ShortDate(e.EventDate)</td>
                        <td>@e.CategoryCount</td>
                        <td>@e.EnrolmentCount</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-rd" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@e.EventID">Enrolments</a>
                            <a class="btn btn-sm btn-outline-rd" asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@e.EventID">Results</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
