@model EventDto
<div class="card rd-card h-100">
    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <img src="@Fmt.ImageUrl(Model.BannerImageUrl)" class="card-img-top rd-banner" alt="Banner for @Model.Name" loading="lazy" />
    }
    else
    {
        <div class="rd-banner rd-banner-empty">@Fmt.TypeIcon(Model.EventType)</div>
    }
    <div class="card-body d-flex flex-column">
        <span class="rd-type">@Fmt.TypeIcon(Model.EventType) @Model.EventType</span>
        <h5 class="card-title mt-1">@Model.Name</h5>
        <p class="rd-meta mb-1">📅 @Fmt.Date(Model.EventDate)</p>
        <p class="rd-meta mb-1">📍 @Model.Location</p>
        <p class="rd-meta mb-3">📏 @Model.DistanceKm.ToString("0.#") km</p>
        <a class="btn btn-rd mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventID">View event</a>
    </div>
</div>
