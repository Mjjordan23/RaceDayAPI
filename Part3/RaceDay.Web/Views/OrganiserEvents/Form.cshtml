@model EventFormViewModel
@{
    var editing = Model.EventID > 0;
    ViewData["Title"] = editing ? "Edit event" : "New event";
}
<h1 class="rd-title">@ViewData["Title"]</h1>
<div class="card rd-card p-4">
    <form method="post" enctype="multipart/form-data" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.EventID : (int?)null)" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">🏃 Run</option>
                    <option value="Walk">🚶 Walk</option>
                    <option value="Cycle">🚴 Cycle</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Banner" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                {
                    <div class="mb-2"><img src="@Fmt.ImageUrl(Model.BannerImageUrl)" class="rd-banner-preview" alt="Current banner" /></div>
                }
                <input asp-for="Banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" />
                <div class="form-text">Optional. JPG, PNG or WebP, up to 5 MB. It is saved by the API.</div>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-rd" type="submit">@(editing ? "Save changes" : "Create event")</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
