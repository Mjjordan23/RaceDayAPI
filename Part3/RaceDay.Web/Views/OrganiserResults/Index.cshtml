@model ResultsPageViewModel
@{ ViewData["Title"] = "Results"; }
<h1 class="rd-title">Results</h1>
<partial name="_EventPicker" model="Model" />
@if (Model.SelectedEventId is int eventId)
{
    if (!Model.Rows.Any())
    {
        <div class="rd-empty">Nobody has entered this event yet, so there is nothing to capture.</div>
    }
    else
    {
        <div class="card rd-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Finish time</th><th>Position</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Enrolment.ParticipantName</td>
                            <td>@row.Enrolment.CategoryName</td>
                            <td><partial name="_StatusBadge" model="row.Enrolment.Status" /></td>
                            @if (row.Result is not null)
                            {
                                <td><strong>@Fmt.Time(row.Result.FinishTime)</strong></td>
                                <td><strong>@(row.Result.FinishPosition.HasValue ? Fmt.Ordinal(row.Result.FinishPosition.Value) : "—")</strong></td>
                            }
                            else
                            {
                                <td colspan="2">
                                    <form asp-action="Capture" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="eventId" value="@eventId" />
                                        <input type="hidden" name="enrolmentId" value="@row.Enrolment.EnrolmentID" />
                                        <input name="finishTime" class="form-control form-control-sm" placeholder="h:mm:ss" style="max-width:110px" required />
                                        <input name="finishPosition" type="number" min="1" class="form-control form-control-sm" placeholder="Pos" style="max-width:80px" required />
                                        <button class="btn btn-sm btn-rd" type="submit">Save</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
